@echo off
chcp 65001 > nul
title [차를 쓰다] 스마트폰 & PC 실시간 미리보기
cd /d "%~dp0"
cls
echo ================================================================
echo    [차를 쓰다] 실시간 미리보기 서버를 실행합니다.
echo ================================================================
echo.
echo  [PC 브라우저 접속]
echo    -> http://localhost:8080
echo.
echo  [스마트폰 접속 (동일 Wi-Fi 연결 시)]
echo    -> http://192.168.0.217:8080
echo.
echo ================================================================
echo  종료하려면 이 창을 닫아주세요.
echo ================================================================
echo.
start http://localhost:8080
python -m http.server 8080 --bind 0.0.0.0
pause
