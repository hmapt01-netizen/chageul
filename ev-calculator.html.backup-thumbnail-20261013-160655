    <!-- ⚡ 계산기 인터랙션 초경량 스크립트 -->
    <script>
        // --- 전역 상태 변수 ---
        let currentIcePrice = 5200; // 만원 (기본: 그랜저 하브)
        let currentCarEff = 16.5;   // km/L
        let currentFuelPrice = 1680; // 원/L
        let currentDist = 10000;    // km
        let currentSlowRatio = 80;  // %
        let currentSlowPrice = 230; // 원/kWh
        let currentFastPrice = 347.2; // 원/kWh

        let currentEvPrice = 2700;  // 만원 (기본: 캐스퍼 일렉트릭)
        let currentEvEff = 5.6;     // km/kWh

        let currentIceName = '그랜저·중대형 하브';
        let currentEvName = '캐스퍼 일렉트릭';

        // 탭 2 상태
        let curBatCap = 84;
        let curStartSoc = 20;
        let curEndSoc = 80;
        let curChargerKw = 100;
        let curUnitPrice = 347.2;

        // 탭 3 상태
        let curCertRange = 450;
        let curHasHp = true;
        let curTemp = -6.7;

        // 탭 전환
        function setTab(tabId, btn) {
            document.querySelectorAll('.ev-tab-btn').forEach(b => b.classList.remove('active'));
            document.querySelectorAll('.ev-tab-content').forEach(c => c.classList.remove('active'));
            btn.classList.add('active');
            const target = document.getElementById(tabId);
            if (target) target.classList.add('active');
        }

        // 탭 1 버튼 액션: 내 기존 차종 선택
        function chooseIceCar(name, eff, fuelPrice, basePrice, btn) {
            btn.parentElement.querySelectorAll('.choice-pill').forEach(p => p.classList.remove('active'));
            btn.classList.add('active');
            currentIceName = name;
            currentCarEff = eff;
            currentFuelPrice = fuelPrice;
            currentIcePrice = basePrice;

            document.getElementById('rgIcePrice').value = basePrice;
            document.getElementById('vCustomIcePrice').innerText = basePrice.toLocaleString() + '만 원';
            document.getElementById('rgIceEff').value = eff;
            document.getElementById('vCustomIceEff').innerText = eff.toFixed(1) + ' km/L';
            document.getElementById('numFuelPrice').value = fuelPrice;

            document.getElementById('txtIceChoice').innerText = `${name} (${eff.toFixed(1)} km/L · ${basePrice.toLocaleString()}만 원)`;
            calcSavings();
        }

        // 탭 1 버튼 액션: 비교할 전기차 선택
        function chooseEvCar(name, eff, realPrice, btn) {
            btn.parentElement.querySelectorAll('.choice-pill').forEach(p => p.classList.remove('active'));
            btn.classList.add('active');
            currentEvName = name;
            currentEvEff = eff;
            currentEvPrice = realPrice;

            document.getElementById('rgEvPrice').value = realPrice;
            document.getElementById('vCustomEvPrice').innerText = realPrice.toLocaleString() + '만 원';
            document.getElementById('rgEvEff').value = eff;
            document.getElementById('vCustomEvEff').innerText = eff.toFixed(1) + ' km/kWh';

            document.getElementById('txtEvChoice').innerText = `${name} (${eff.toFixed(1)} km/kWh · 실구매 ${realPrice.toLocaleString()}만 원)`;
            calcSavings();
        }

        function chooseDist(dist, btn) {
            btn.parentElement.querySelectorAll('.choice-pill').forEach(p => p.classList.remove('active'));
            btn.classList.add('active');
            currentDist = dist;
            document.getElementById('txtDistChoice').innerText = dist.toLocaleString() + ' km';
            calcSavings();
        }

        function chooseCharge(ratio, btn) {
            btn.parentElement.querySelectorAll('.choice-pill').forEach(p => p.classList.remove('active'));
            btn.classList.add('active');
            currentSlowRatio = ratio;
            const labels = {
                80: '아파트 집밥 80% + 급속 20%',
                100: '집밥 완속 100% (알뜰)',
                0: '공용 급속 100% (집밥 없음)'
            };
            document.getElementById('txtChargeChoice').innerText = labels[ratio] || '';
            calcSavings();
        }

        function syncSlowPrice(val) {
            const num = parseFloat(val) || 230;
            currentSlowPrice = num;
            const el = document.getElementById('numSlowPrice');
            if (el) el.value = num;
            calcSavings();
        }

        function syncFastPrice(val) {
            const num = parseFloat(val) || 347.2;
            currentFastPrice = num;
            const el = document.getElementById('numFastPrice');
            if (el) el.value = num;
            calcSavings();
        }

        function toggleAccordion(id, btn) {
            const body = document.getElementById(id);
            const icon = document.getElementById('accIcon1');
            if (body.classList.contains('open')) {
                body.classList.remove('open');
                icon.innerText = '▼';
            } else {
                body.classList.add('open');
                icon.innerText = '▲';
            }
        }

        function onCustomChange() {
            currentIcePrice = parseFloat(document.getElementById('rgIcePrice').value) || 5200;
            currentCarEff = parseFloat(document.getElementById('rgIceEff').value) || 16.5;
            currentFuelPrice = parseFloat(document.getElementById('numFuelPrice').value) || 1680;

            currentEvPrice = parseFloat(document.getElementById('rgEvPrice').value) || 2700;
            currentEvEff = parseFloat(document.getElementById('rgEvEff').value) || 5.6;

            currentSlowPrice = parseFloat(document.getElementById('numSlowPrice').value) || 230;
            currentFastPrice = parseFloat(document.getElementById('numFastPrice').value) || 347.2;

            const elSlow = document.getElementById('inpSlowPrice');
            const elFast = document.getElementById('inpFastPrice');
            if (elSlow) elSlow.value = currentSlowPrice;
            if (elFast) elFast.value = currentFastPrice;

            document.getElementById('vCustomIcePrice').innerText = currentIcePrice.toLocaleString() + '만 원';
            document.getElementById('vCustomIceEff').innerText = currentCarEff.toFixed(1) + ' km/L';
            document.getElementById('vCustomEvPrice').innerText = currentEvPrice.toLocaleString() + '만 원';
            document.getElementById('vCustomEvEff').innerText = currentEvEff.toFixed(1) + ' km/kWh';

            document.getElementById('txtIceChoice').innerText = `사용자 맞춤 (${currentCarEff.toFixed(1)} km/L · ${currentIcePrice.toLocaleString()}만 원)`;
            document.getElementById('txtEvChoice').innerText = `사용자 맞춤 (${currentEvEff.toFixed(1)} km/kWh · ${currentEvPrice.toLocaleString()}만 원)`;

            calcSavings();
        }

        function calcSavings() {
            // 1. 내연기관 1년 유류비 = (주행거리 / 연비) * 유가
            const iceCost = (currentDist / currentCarEff) * currentFuelPrice;

            // 2. 전기차 1년 충전비 = (주행거리 / 전비) * 가중평균단가
            const avgKwhPrice = (currentSlowPrice * (currentSlowRatio / 100)) + (currentFastPrice * ((100 - currentSlowRatio) / 100));
            const evCost = (currentDist / currentEvEff) * avgKwhPrice;

            // 3. 절감액
            const annualSave = iceCost - evCost;
            const fiveSave = annualSave * 5;

            // 4. 차량 구매 차액 = 전기차 실구매가 - 기존 내연기관 출고가 (만 원 단위)
            const priceDiffMan = currentEvPrice - currentIcePrice;

            // DOM 갱신: 주유비 및 충전비
            document.getElementById('sumIceCost').innerText = Math.round(iceCost).toLocaleString() + '원';
            document.getElementById('sumEvCost').innerText = Math.round(evCost).toLocaleString() + '원';

            // 메인 히어로 카드 (순수 연료비 절감액 중심)
            if (annualSave > 0) {
                const monthlySave = Math.round(annualSave / 12);
                const annualSaveMan = (annualSave / 10000).toFixed(1);
                const fiveSaveMan = (fiveSave / 10000).toFixed(0);

                document.getElementById('heroAnnualSave').innerText = `연 약 ${annualSaveMan}만 원 절약`;
                document.getElementById('heroAnnualSaveSub').innerText = `기존 주유비 대비 월 약 ${(monthlySave / 10000).toFixed(1)}만 원 · 5년 누적 약 ${fiveSaveMan}만 원 절감`;

                document.getElementById('sumAnnualSave').innerText = Math.round(annualSave).toLocaleString() + '원 (월 약 ' + (monthlySave / 10000).toFixed(1) + '만 원 절약)';
                document.getElementById('sumFiveSave').innerText = Math.round(fiveSave).toLocaleString() + '원 절약';
            } else {
                document.getElementById('heroAnnualSave').innerText = '연료비 절감 효과 미미';
                document.getElementById('heroAnnualSaveSub').innerText = '현재 주행거리 및 연비 조건에서는 내연기관 주유비와 충전비 차이가 거의 없습니다.';
                document.getElementById('sumAnnualSave').innerText = '0원 (절감 불가)';
                document.getElementById('sumFiveSave').innerText = '0원';
            }

            // 차량 구매 차액 & 본전 분석 카드
            const card = document.getElementById('paybackCard');
            const badge = document.getElementById('paybackBadge');
            const title = document.getElementById('paybackTitle');
            const desc = document.getElementById('paybackDesc');

            if (priceDiffMan < -100) {
                // 전기차가 100만원 이상 더 저렴한 경우 (예: 그랜저 하브 vs 캐스퍼 EV)
                const saveDiff = Math.abs(priceDiffMan);
                card.className = 'payback-card green';
                badge.className = 'payback-badge green';
                badge.innerText = `🟢 전기차(${currentEvName})가 약 ${saveDiff.toLocaleString()}만 원 더 저렴!`;
                title.innerText = `본전 회수 기간: 계산 불필요 (구입 즉시 ${saveDiff.toLocaleString()}만 원 세이브)`;
                const annualAdd = annualSave > 0 ? `매년 기름값 ${(annualSave / 10000).toFixed(1)}만 원을 추가로 절감` : '유지비 절감 효과 누림';
                desc.innerText = `기존 차량(${currentIceName}, 약 ${currentIcePrice.toLocaleString()}만 원) 대비 전기차(${currentEvName}, 실구매 약 ${currentEvPrice.toLocaleString()}만 원) 가격이 훨씬 저렴합니다. 첫날부터 차값 ${saveDiff.toLocaleString()}만 원을 아끼고, ${annualAdd}합니다.`;
            } else if (priceDiffMan <= 150 && priceDiffMan >= -100) {
                // 가격 차이가 거의 없는 경우 (동급/유사 가격대, 차액 150만원 이내)
                card.className = 'payback-card blue';
                badge.className = 'payback-badge blue';
                badge.innerText = `🟡 차량 구매 가격 동등 수준 (차액 거의 없음)`;
                title.innerText = `본전 회수 기간: 즉시 이득 전환 (출고 직후부터 순수 절약)`;
                desc.innerText = `${currentIceName}(약 ${currentIcePrice.toLocaleString()}만 원)과 ${currentEvName}(실구매 약 ${currentEvPrice.toLocaleString()}만 원)의 실구매가 차이가 거의 없어, 출고 첫 달부터 발생하는 매달 약 ${(Math.max(0, annualSave) / 12 / 10000).toFixed(1)}만 원의 주유비 절감 효과를 그대로 누립니다.`;
            } else {
                // 전기차가 더 비싼 경우 (차액 회수 기간 계산)
                card.className = 'payback-card slate';
                badge.className = 'payback-badge slate';
                badge.innerText = `🔵 전기차(${currentEvName}) 실구매가가 약 ${priceDiffMan.toLocaleString()}만 원 더 높음`;

                if (annualSave > 0) {
                    const totalDiffWon = priceDiffMan * 10000;
                    const years = totalDiffWon / annualSave;
                    const y = Math.floor(years);
                    const m = Math.round((years - y) * 12);
                    const totalKm = Math.round(years * currentDist);

                    let timeStr = '';
                    if (y > 0 && m > 0) timeStr = `약 ${y}년 ${m}개월`;
                    else if (y > 0) timeStr = `약 ${y}년`;
                    else timeStr = `약 ${m}개월`;

                    title.innerText = `연료비로 차액 회수까지: ${timeStr}`;
                    desc.innerText = `누적 약 ${(totalKm / 10000).toFixed(1)}만 km 주행 시 차량 구매 차액(${priceDiffMan.toLocaleString()}만 원)을 순수 연료비 절감액으로 회수합니다. 연간 주행거리가 길수록 회수 기간이 단축됩니다.`;
                } else {
                    title.innerText = `차액 회수 불가`;
                    desc.innerText = `현재 유가와 전비 조건에서는 충전비 절감액이 없어 차량 구매 차액을 연료비로 회수할 수 없습니다.`;
                }
            }
        }

        // 탭 2 함수들
        function chooseBattery(cap, btn) {
            btn.parentElement.querySelectorAll('.choice-pill').forEach(p => p.classList.remove('active'));
            btn.classList.add('active');
            curBatCap = cap;
            document.getElementById('txtBatChoice').innerText = btn.querySelector('span:first-child').innerText + ' (' + cap + ' kWh)';
            calcCharge();
        }

        function chooseSoc(start, end, btn) {
            btn.parentElement.querySelectorAll('.choice-pill').forEach(p => p.classList.remove('active'));
            btn.classList.add('active');
            curStartSoc = start;
            curEndSoc = end;
            document.getElementById('txtSocChoice').innerText = `${start}% → ${end}%`;
            calcCharge();
        }

        function chooseKw(kw, btn) {
            btn.parentElement.querySelectorAll('.choice-pill').forEach(p => p.classList.remove('active'));
            btn.classList.add('active');
            curChargerKw = kw;
            document.getElementById('txtChargerChoice').innerText = `${kw}kW 충전기`;
            calcCharge();
        }

        function setTab2Price(price, btn) {
            if (btn && btn.parentElement) {
                btn.parentElement.querySelectorAll('.preset-pill').forEach(p => p.classList.remove('active'));
                btn.classList.add('active');
            }
            curUnitPrice = price;
            const inp = document.getElementById('inpTab2Price');
            const rg = document.getElementById('rgTab2Price');
            if (inp) inp.value = price;
            if (rg) rg.value = Math.min(500, Math.max(150, Math.round(price)));
            document.getElementById('txtUnitPriceChoice').innerText = `${price}원 / kWh`;
            calcCharge();
        }

        function onTab2PriceInput(val) {
            const price = parseFloat(val) || 0;
            curUnitPrice = price;
            const rg = document.getElementById('rgTab2Price');
            if (rg) rg.value = Math.min(500, Math.max(150, Math.round(price)));
            document.getElementById('txtUnitPriceChoice').innerText = `${price}원 / kWh`;
            document.querySelectorAll('.preset-pill').forEach(p => p.classList.remove('active'));
            calcCharge();
        }

        function onTab2PriceSlider(val) {
            const price = parseFloat(val) || 0;
            curUnitPrice = price;
            const inp = document.getElementById('inpTab2Price');
            if (inp) inp.value = price;
            document.getElementById('txtUnitPriceChoice').innerText = `${price}원 / kWh`;
            document.querySelectorAll('.preset-pill').forEach(p => p.classList.remove('active'));
            calcCharge();
        }

        function calcCharge() {
            const netKwh = curBatCap * ((curEndSoc - curStartSoc) / 100);
            const lossRate = curChargerKw <= 11 ? 0.08 : 0.12; // 손실율
            const gridKwh = netKwh / (1 - lossRate);
            const totalCost = Math.round(gridKwh * curUnitPrice);

            document.getElementById('sumNetKwh').innerText = netKwh.toFixed(1) + ' kWh';
            document.getElementById('sumGridKwh').innerText = '약 ' + gridKwh.toFixed(1) + ' kWh';
            document.getElementById('sumUnitPrice').innerText = curUnitPrice + '원 / kWh';
            document.getElementById('heroChargeCost').innerText = '약 ' + totalCost.toLocaleString() + '원';

            // 시간 계산
            let effectiveKw = Math.min(curChargerKw, 220);
            if (curChargerKw >= 100) effectiveKw = effectiveKw * 0.72; // BMS 감속 평균
            const hours = netKwh / effectiveKw;
            const mins = Math.round(hours * 60);

            if (mins >= 60) {
                const h = Math.floor(mins / 60);
                const m = mins % 60;
                document.getElementById('heroChargeTime').innerText = `예상 소요 시간: 약 ${h}시간 ${m}분`;
            } else {
                document.getElementById('heroChargeTime').innerText = `예상 소요 시간: 약 ${mins}분 ~ ${mins + 10}분`;
            }
        }

        // 탭 3 함수들
        function chooseCert(dist, btn) {
            btn.parentElement.querySelectorAll('.choice-pill').forEach(p => p.classList.remove('active'));
            btn.classList.add('active');
            curCertRange = dist;
            document.getElementById('txtCertChoice').innerText = dist + ' km';
            calcWinter();
        }

        function chooseHp(hasHp, btn) {
            btn.parentElement.querySelectorAll('.choice-pill').forEach(p => p.classList.remove('active'));
            btn.classList.add('active');
            curHasHp = hasHp;
            document.getElementById('txtHpChoice').innerText = hasHp ? '히트펌프 탑재' : '일반 PTC 히터';
            calcWinter();
        }

        function chooseTemp(temp, btn) {
            btn.parentElement.querySelectorAll('.choice-pill').forEach(p => p.classList.remove('active'));
            btn.classList.add('active');
            curTemp = temp;
            document.getElementById('txtTempChoice').innerText = temp + '℃';
            calcWinter();
        }

        function calcWinter() {
            let ratio = 1.0;
            if (curTemp >= 15) {
                ratio = 1.0;
            } else if (curTemp >= 0) {
                ratio = curHasHp ? 0.90 : 0.85;
            } else if (curTemp >= -10) {
                ratio = curHasHp ? 0.80 : 0.70;
            } else {
                ratio = curHasHp ? 0.70 : 0.58;
            }

            const estRange = Math.round(curCertRange * ratio);
            const lossKm = curCertRange - estRange;
            const lossPct = Math.round((1 - ratio) * 100);

            document.getElementById('sumBaseRange').innerText = curCertRange + ' km (100%)';
            document.getElementById('sumLossKm').innerText = `약 -${lossKm} km (${lossPct}% 감소)`;
            document.getElementById('sumDefendRate').innerText = curHasHp ? '히트펌프 탑재 약 ' + Math.round(ratio * 100) + '% 방어' : 'PTC 전용 약 ' + Math.round(ratio * 100) + '% 방어';

            document.getElementById('heroWinterRange').innerText = `약 ${estRange - 10} ~ ${estRange + 10} km`;
            document.getElementById('heroWinterLoss').innerText = `상온 ${curCertRange}km 대비 약 ${lossPct}% 감소 예상`;
        }

        // 초기 계산 실행
        window.addEventListener('DOMContentLoaded', () => {
            calcSavings();
            calcCharge();
            calcWinter();
        });

        function copyCurrentUrl() {
            navigator.clipboard.writeText(window.location.href).then(() => {
                alert('링크가 복사되었습니다.');
            }).catch(() => {
                prompt('이 글의 링크입니다:', window.location.href);
            });
        }
    </script>
